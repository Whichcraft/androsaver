<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView android:id="@+id/imageView2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:alpha="0" />
    <ImageView android:id="@+id/imageView1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:alpha="1" />

    <!-- Full-screen visualizer: used in Visualizer mode -->
    <FrameLayout android:id="@+id/visualizerContainer" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />

    <TextView android:id="@+id/statusText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:textColor="#FFFFFF" android:textSize="24sp" android:padding="24dp" android:gravity="center" android:shadowColor="#000000" android:shadowDx="2" android:shadowDy="2" android:shadowRadius="4" android:visibility="gone" />

    <TextView android:id="@+id/sourceHealth"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|start" android:layout_margin="24dp"
        android:padding="12dp" android:maxWidth="480dp" android:textSize="14sp"
        android:background="#B0000000" android:textColor="#FFFFFF"
        android:visibility="gone" android:importantForAccessibility="yes" />

    <!-- Clock overlay: bottom-right corner -->
    <TextView android:id="@+id/clockOverlay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_margin="32dp" android:textColor="#CCFFFFFF" android:textSize="28sp" android:gravity="end" android:fontFamily="sans-serif-light" android:shadowColor="#CC000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="6" android:visibility="gone" />

    <!-- Weather widget: top-right corner -->
    <LinearLayout android:id="@+id/weatherWidget" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_margin="32dp" android:orientation="vertical" android:gravity="end" android:visibility="gone">
        <TextView android:id="@+id/weatherTemp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#CCFFFFFF" android:textSize="36sp" android:textStyle="bold" android:shadowColor="#CC000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="6" />
        <TextView android:id="@+id/weatherDesc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#AAFFFFFF" android:textSize="18sp" android:shadowColor="#CC000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="4" />
    </LinearLayout>

    <!-- Dev-only visualizer samples; persistent errors always remain above this. -->
    <TextView
        android:id="@+id/devPerformanceOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:padding="8dp"
        android:background="#B0000000"
        android:textColor="#FFFFFFFF"
        android:fontFamily="monospace"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Dev builds only: persistent crash diagnostics. Kept as the final child
         so it can always be raised above slideshow images and normal overlays. -->
    <TextView
        android:id="@+id/devErrorOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0180000"
        android:fontFamily="monospace"
        android:gravity="top|start"
        android:padding="24dp"
        android:scrollbars="vertical"
        android:textColor="#FFFFFFFF"
        android:textIsSelectable="true"
        android:textSize="15sp"
        android:visibility="gone" />

</FrameLayout>
